{
  "manifest_version": 3,
  "name": "ClipCargo",
  "version": "0.1.6",
  "key": "",
  "description": "把你主动选择的视频页面收进 ClipCargo。",
  "icons": { "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "alarms", "contextMenus", "nativeMessaging", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.douyin.com/*",
        "https://www.tiktok.com/*",
        "https://www.bilibili.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://vimeo.com/*",
        "https://www.dailymotion.com/*",
        "https://www.twitch.tv/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/32.png", "icons/download.svg", "icons/folder.svg"],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "收进 ClipCargo",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/32.png", "64": "icons/64.png" }
  }
}
